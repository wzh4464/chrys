AskUserDialog {
    align: center middle;
    background: $background 40%;
}

#askuser-container {
    width: 100;
    max-width: 90%;
    height: auto;
    max-height: 85%;
    min-height: 8;
    background: $surface;
    border: round $tui-border-accent $border-opacity;
    border-title-color: $accent;
    border-title-style: bold;
}

#askuser-inner {
    background: $surface;
    scrollbar-color: $accent;
    scrollbar-color-hover: $accent;
    scrollbar-color-active: $accent;
}

#askuser-footer {
    dock: bottom;
    width: 100%;
    height: auto;
}

#askuser-question {
    width: 100%;
    height: auto;
    overflow-y: hidden;
    text-align: left;
    text-style: bold;
    margin: 1 2 0 2;
    padding: 0;
}

#askuser-options {
    width: 100%;
    height: auto;
    margin: 1 1 0 1;
    padding: 0;
}

#askuser-options > Button {
    width: 100%;
    margin-bottom: 0;
}

#askuser-options > .askuser-option-last {
    margin-bottom: 0;
}

#askuser-input {
    width: 100%;
    height: auto;
    /* Keep in sync with ASK_USER_INPUT_MIN_HEIGHT / ASK_USER_INPUT_MAX_HEIGHT. */
    min-height: 3;
    max-height: 7;
    border: round $tui-border-accent $border-opacity;
    margin: 1 1 0 1;
}

#askuser-buttons {
    width: 100%;
    align: center top;
    height: 3;
    padding: 0 1 0 1;
}

#askuser-buttons > Button {
    margin: 0 1;
}

#askuser-buttons #askuser-inline {
    min-width: 13;
}
