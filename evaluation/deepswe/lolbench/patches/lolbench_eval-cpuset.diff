+def _cpuset_args(instance_id: str, cpus: str) -> list:
+    """Pin the agent container to a block of cores so toolchains size their worker
+    pools from the container, not the host (jest spawned 95 workers on a 96-core host
+    under a 7 GiB limit and was OOM-killed). Node's os.availableParallelism() follows
+    the affinity mask; --cpus alone does not change it. LOLBENCH_CPUSET_CORES (default:
+    all cores) bounds the pool; blocks of ceil(cpus) cores are picked by a stable hash."""
+    import math
+    import zlib
+    total = int(os.environ.get("LOLBENCH_CPUSET_CORES", "0") or 0) or (os.cpu_count() or 1)
+    width = max(1, math.ceil(float(cpus)))
+    blocks = max(1, total // width)
+    block = zlib.crc32(instance_id.encode()) % blocks
+    first = block * width
+    return ["--cpuset-cpus", f"{first}-{first + width - 1}"]
