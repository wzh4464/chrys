# Append the relevant values to ~/.chrys/.env. Do not commit real credentials.

# Validated selected-Harbor graph. The MCP bridge opens Neo4j read sessions
# directly; no ContextGraph checkout or HTTP query service is needed at runtime.
CONTEXTGRAPH_NEO4J_URI=bolt://127.0.0.1:7705
CONTEXTGRAPH_NEO4J_USER=neo4j
CONTEXTGRAPH_NEO4J_PASSWORD=replace-me

# Optional vector channel. Without an API key, retrieval automatically falls
# back to Neo4j's canonical_rule_text full-text index.
CONTEXTGRAPH_EMBEDDING_BASE_URL=https://example.invalid/v1
CONTEXTGRAPH_EMBEDDING_API_KEY=replace-me
CONTEXTGRAPH_EMBEDDING_MODEL=text-embedding-3-large
