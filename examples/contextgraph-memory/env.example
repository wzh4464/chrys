# Append the relevant values to ~/.chrys/.env. Do not commit real credentials.

# ContextGraph checkout containing scripts/baselines/contextgraph_pro_server.py
# and a synced .venv (`uv sync --extra dev`).
CG_REPO=/path/to/ContextGraph

# Validated selected-Harbor graph. The graph process is managed separately;
# the hook starts only the loopback HTTP query service.
CONTEXTGRAPH_NEO4J_URI=bolt://127.0.0.1:7705
CONTEXTGRAPH_NEO4J_USER=neo4j
CONTEXTGRAPH_NEO4J_PASSWORD=replace-me

# The Chrys MCP bridge calls this loopback service.
CONTEXTGRAPH_SERVER_URL=http://127.0.0.1:8010

# Optional: start the ContextGraph query service on Memory-profile sessions.
CHRYS_AUTOSTART_CONTEXTGRAPH=1

# ContextGraph reads embedding configuration from $CG_REPO/.env. It needs an
# OpenAI-compatible endpoint because each query must be embedded in the same
# 3,072-dimensional space used to build the graph:
# OPENAI_API_BASE=https://example.invalid/v1
# OPENAI_API_KEY=replace-me
# EMBEDDING_MODEL=text-embedding-3-large
