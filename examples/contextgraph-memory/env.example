# Append the relevant values to ~/.chrys/.env. Do not commit real credentials.

# Validated selected-Harbor graph. The MCP bridge opens Neo4j read sessions
# directly; no HTTP query service is needed.
CONTEXTGRAPH_NEO4J_URI=bolt://127.0.0.1:7705
CONTEXTGRAPH_NEO4J_USER=neo4j
CONTEXTGRAPH_NEO4J_PASSWORD=replace-me

# Vector channel. Optional for READS -- retrieval falls back to Neo4j's
# canonical_rule_text full-text index without a key -- but REQUIRED for writes:
# ContextGraph's AgentMemory.learn embeds every fragment it deposits, so
# without a key the system reads forever and never writes.
CONTEXTGRAPH_EMBEDDING_BASE_URL=https://example.invalid/v1
CONTEXTGRAPH_EMBEDDING_API_KEY=replace-me
CONTEXTGRAPH_EMBEDDING_MODEL=text-embedding-3-large

# Dynamic writes run ContextGraph's AgentMemory.learn from this checkout.
CONTEXTGRAPH_REPO=~/codes/ContextGraph
# Optional override; otherwise <repo>/.venv/bin/python (or Scripts/python.exe)
# is used, followed by the Chrys interpreter as a final fallback.
# CONTEXTGRAPH_PYTHON=/path/to/ContextGraph/.venv/bin/python
# Preserve AgentMemory's periodic consolidation cadence across isolated writes.
CONTEXTGRAPH_CONSOLIDATE_EVERY=16
# CONTEXTGRAPH_DEPOSIT_TIMEOUT_SECONDS=300

# Opt in to automatic after-turn deposition as ordinary ContextGraph
# Trajectory / Fragment / ErrorPattern memory.
CONTEXTGRAPH_DYNAMIC_DEPOSIT=1

# Optional when Chrys stores sessions outside its configured/default root and
# the hook worker cannot resolve that setting. This is the root containing the
# `sessions/` directory, not the sessions directory itself.
# CONTEXTGRAPH_SESSION_ROOT_DIR=/path/to/chrys-session-root
